{
  "name": "novagadget-inventory",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "cd frontend && vite",
    "build": "cd frontend && tsc && vite build",
    "preview": "cd frontend && vite preview",
    "start": "node backend/index.js",
    "server": "node backend/index.js",
    "server:stop": "lsof -ti:3002 | xargs kill -9 2>/dev/null || fuser -k 3002/tcp 2>/dev/null || echo 'No server running on port 3002'",
    "server:restart": "npm run server:stop && sleep 1 && npm run server",
    "dev:full": "concurrently \"npm run server\" \"npm run dev\"",
    "migrate": "node backend/scripts/migrate.js",
    "backup": "node backend/scripts/backup-db.js",
    "backup:before-update": "node backend/scripts/backup-db.js && echo '✅ Backup created before update'",
    "pre-update-check": "node backend/scripts/pre-update-check.js",
    "safe-update": "npm run backup && npm run pre-update-check && echo '✅ Safe to proceed with update'"
  },
  "dependencies": {
    "@types/qrcode.react": "^3.0.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^9.2.2",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hotkeys-hook": "^5.2.1",
    "recharts": "^3.6.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.2.2",
    "vite": "^4.5.3",
    "vite-plugin-pwa": "^1.2.0"
  }
}
